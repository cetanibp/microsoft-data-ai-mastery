  "queries": [
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "b78f3f8a-8137-479b-a8bd-c595388e9a6d"
      },
      "text": "OperationalObjectCurrent()\r\n| summarize ObjectRunCount = count() by Status\r\n| order by ObjectRunCount desc",
      "id": "a9cfa80e-6d8e-4edb-8e90-d44f2bb286b9",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "b78f3f8a-8137-479b-a8bd-c595388e9a6d"
      },
      "text": "OperationalObjectCurrent()\r\n| where\r\n    Status in (\"FAILED\", \"QUALITY_BLOCKED\", \"RECOVERY_REQUIRED\")\r\n    or Severity in (\"ERROR\", \"CRITICAL\")\r\n| summarize ActiveConditionCount = count()",
      "id": "0101c3fd-9310-4415-b69e-da9a834bede1",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "b78f3f8a-8137-479b-a8bd-c595388e9a6d"
      },
      "text": "OperationalEventAccepted()\r\n| where IngestedAtUtc > ago(24h)\r\n| extend IngestionLatencySeconds =\r\n    datetime_diff(\"second\", IngestedAtUtc, EmittedAtUtc)\r\n| summarize\r\n    P50 = percentile(IngestionLatencySeconds, 50),\r\n    P95 = percentile(IngestionLatencySeconds, 95),\r\n    Maximum = max(IngestionLatencySeconds)\r\n    by TimeBucket = bin(IngestedAtUtc, 1m)\r\n| order by TimeBucket asc",
      "id": "60113035-a159-4bcf-b6c3-730e2f87a2fe",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "b78f3f8a-8137-479b-a8bd-c595388e9a6d"
      },
      "text": "OperationalEventValidated()\r\n| where IngestedAtUtc > ago(24h)\r\n| extend\r\n    Scenario = tostring(Details.scenario),\r\n    IngestionLatencySeconds =\r\n        datetime_diff(\"second\", IngestedAtUtc, EmittedAtUtc)\r\n| project\r\n    IngestedAtUtc,\r\n    EventTimeUtc,\r\n    PipelineName,\r\n    ObjectName,\r\n    EventType,\r\n    Status,\r\n    Severity,\r\n    ValidationStatus,\r\n    RejectionReason,\r\n    IsLate,\r\n    IngestionLatencySeconds,\r\n    Scenario,\r\n    CorrelationId\r\n| top 100 by IngestedAtUtc desc",
      "id": "f82842d7-ad0d-4b48-9a60-44d654fdeef0",
      "usedVariables": []
    }
  ],
